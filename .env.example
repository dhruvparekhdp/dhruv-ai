# Copy to .env on the host. Never commit the real .env — it is gitignored.

# --- Access control ---------------------------------------------------------
# Required on every API call and the WebSocket handshake. Any string you like.
# Leave empty ONLY on localhost; unset means the API is open to anyone who can
# reach it.
JARVIS_PASSCODE=change-me

# --- LLM engines ------------------------------------------------------------
# Both optional. With neither set, Jarvis runs on its local fallback engine and
# says so rather than pretending to be a model.
# Groq:             https://console.groq.com
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Model overrides. Defaults are openai/gpt-oss-120b and gemini-2.5-flash.
# NOTE: llama-3.3-70b-versatile is retired on 2026-08-16. Do not set it back.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# Optional Tavily key for web.search. Without it the tool reports itself
# unconfigured instead of inventing results.
# SEARCH_API_KEY=

# --- Storage ----------------------------------------------------------------
# Unset -> local SQLite file (fine for development and tests).
# Set   -> Postgres. This is what the host runs.
# DATABASE_URL=postgresql://jarvis:password@localhost/jarvis
# JARVIS_DB_PATH=jarvis_system.db

# --- HTTP surface -----------------------------------------------------------
# Browser origins allowed to call the API with credentials. Empty (the
# default) is same-origin only, which is what the PWA needs. A `*` is ignored
# and never paired with credentials. List extra origins explicitly, no slash:
# JARVIS_CORS_ORIGINS=http://localhost:8100
# Largest request body, in bytes. Default 1 MiB. There is no upload route.
# JARVIS_MAX_BODY_BYTES=1048576
# Mission starts and model calls (command + mood) per window. One shared
# window for the process, not per client address.
# JARVIS_MISSION_RATE_LIMIT=10
# JARVIS_LLM_RATE_LIMIT=30
# JARVIS_RATE_WINDOW_SECONDS=60

# --- Misc -------------------------------------------------------------------
# JARVIS_DEBUG=false
