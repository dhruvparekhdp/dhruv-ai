# Copy to .env on the host. Never commit the real .env — it is gitignored.

# --- Access control ---------------------------------------------------------
# Required. If this is unset the process refuses to start.
# The only exception is loopback development: JARVIS_DEV_INSECURE=1 and a bind
# of 127.0.0.1, which logs a loud warning and serves with auth off.
JARVIS_PASSCODE=change-me

# Listen address. Default 127.0.0.1. Tailscale Funnel proxies to localhost,
# so this can stay. Binding 0.0.0.0 also requires JARVIS_ALLOW_PUBLIC_BIND=1.
# JARVIS_HOST=127.0.0.1
# JARVIS_PORT=8000
# JARVIS_ALLOW_PUBLIC_BIND=0

# Session lifetime in seconds. Default 12 hours.
# JARVIS_SESSION_TTL_SECONDS=43200
# Lockout: N failed logins, then a backoff (seconds) that doubles up to the max.
# JARVIS_LOGIN_MAX_FAILURES=5
# JARVIS_LOGIN_BACKOFF_SECONDS=30
# JARVIS_LOGIN_BACKOFF_MAX_SECONDS=900

# Loopback-only escape hatch. Never set this on a machine other people can reach.
# JARVIS_DEV_INSECURE=0

# --- LLM engines ------------------------------------------------------------
# Both optional. With neither set, Jarvis runs on its local fallback engine and
# says so rather than pretending to be a model.
# Groq:             https://console.groq.com
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Model overrides. Defaults are openai/gpt-oss-120b and gemini-2.5-flash.
# NOTE: llama-3.3-70b-versatile is retired on 2026-08-16. Do not set it back.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# Optional Tavily key for web.search. Without it the tool reports itself
# unconfigured instead of inventing results.
# SEARCH_API_KEY=

# --- Storage ----------------------------------------------------------------
# Unset -> local SQLite file (fine for development and tests).
# Set   -> Postgres. This is what the host runs.
# DATABASE_URL=postgresql://jarvis:password@localhost/jarvis
# JARVIS_DB_PATH=jarvis_system.db

# --- Misc -------------------------------------------------------------------
# JARVIS_DEBUG=false
# JARVIS_CORS_ORIGINS=*
