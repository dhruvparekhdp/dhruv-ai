# Copy to .env on the host. Never commit the real .env — it is gitignored.

# --- Access control ---------------------------------------------------------
# Required on every API call and the WebSocket handshake. Any string you like.
# Leave empty ONLY on localhost; unset means the API is open to anyone who can
# reach it.
JARVIS_PASSCODE=change-me

# --- LLM engines ------------------------------------------------------------
# Both optional. With neither set, Jarvis runs on its local fallback engine and
# says so rather than pretending to be a model.
# Groq:             https://console.groq.com
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=

# Model overrides. Defaults are openai/gpt-oss-120b and gemini-2.5-flash.
# NOTE: llama-3.3-70b-versatile is retired on 2026-08-16. Do not set it back.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# Optional Tavily key for web.search. Without it the tool reports itself
# unconfigured instead of inventing results.
# SEARCH_API_KEY=

# --- Storage ----------------------------------------------------------------
# Unset -> local SQLite file. This is what the host runs (D-027).
# Set   -> Postgres. Supported and tested, not the default.
# DATABASE_URL=postgresql://jarvis:password@localhost/jarvis
# JARVIS_DB_PATH=jarvis_system.db

# --- Telegram ---------------------------------------------------------------
# Jarvis's OWN bot, from BotFather — not the crypto engine's. Two programs
# polling one bot steal each other's messages (D-029).
# Both set -> reminders go out, and the bot answers commands and chat.
# Only messages from TELEGRAM_CHAT_ID are answered; everyone else is ignored.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Set to 0 on a dev laptop while the host is already polling the same bot.
# JARVIS_TELEGRAM_POLL=1

# --- Misc -------------------------------------------------------------------
# JARVIS_DEBUG=false
# JARVIS_CORS_ORIGINS=*
