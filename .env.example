# Copy to .env on the host. Never commit the real .env file.

# Required unique login passcode.
JARVIS_PASSCODE=

# Set to 1 only for an intentionally public bind behind protection.
JARVIS_ALLOW_PUBLIC_BIND=

# Listen address; default is 127.0.0.1.
JARVIS_HOST=

# Optional app display name.
JARVIS_APP_NAME=

# Optional public app URL.
JARVIS_URL=

# Loopback-only development escape hatch; never enable on a reachable host.
JARVIS_DEV_INSECURE=

# Enable debug responses; leave off on deployed hosts.
JARVIS_DEBUG=

# Optional Groq API key.
GROQ_API_KEY=

# Optional Google AI Studio API key.
GEMINI_API_KEY=

# Optional web search provider key.
SEARCH_API_KEY=

# Optional Groq model override.
GROQ_MODEL=

# Optional Gemini model override.
GEMINI_MODEL=

# Set to 1 to enable local Ollama.
JARVIS_OLLAMA=

# Optional Ollama API URL.
OLLAMA_BASE_URL=

# Optional Ollama model name.
OLLAMA_MODEL=

# Optional key that seals provider secrets saved from the Keys page. Unset uses the passcode.
JARVIS_SETTINGS_KEY=

# Optional Postgres URL; unset uses SQLite.
DATABASE_URL=

# Optional SQLite file path.
JARVIS_DB_PATH=

# Optional dedicated Jarvis Telegram bot token.
TELEGRAM_BOT_TOKEN=

# Optional Telegram owner chat ID.
TELEGRAM_CHAT_ID=

# Set to 0 to disable inbound Telegram polling.
JARVIS_TELEGRAM_POLL=

# Set to 0 to disable background scheduled jobs.
JARVIS_SCHEDULE=

# Optional JSON list of health watchers.
JARVIS_WATCHERS_JSON=

# Optional alert deduplication window.
ALERT_DEDUPE_MINUTES=

# Optional drawdown alert threshold.
ALERT_DRAWDOWN_PERCENT=

# Optional alert quiet-hours window.
ALERT_QUIET_HOURS=

# Optional minimum signal strength for alerts.
ALERT_SIGNAL_STRENGTH_MIN=

# Optional stale-data threshold for alerts.
ALERT_STALE_MINUTES=

# Optional local time for the daily briefing.
BRIEFING_TIME=

# Optional OCR service URL.
OCR_BASE_URL=

# Optional OCR confidence threshold.
OCR_REVIEW_CONFIDENCE=

# Optional comma-separated browser origins.
JARVIS_CORS_ORIGINS=

# Optional estimated daily agent budget.
JARVIS_BUDGET_AGENT_USD=

# Optional estimated daily overall budget.
JARVIS_BUDGET_DAY_USD=

# Optional estimated per-mission budget.
JARVIS_BUDGET_MISSION_USD=

# Optional JSON model price overrides.
JARVIS_PRICE_TABLE=

# Test-only Postgres URL; unused by the deployed app.
JARVIS_TEST_DATABASE_URL=
