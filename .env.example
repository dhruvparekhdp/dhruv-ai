# Copy to .env. Do not commit .env. Values belong only in that untracked file.
# This template lists every variable the repo reads. Assignments are blank on purpose.

# --- Access control ---
# Shared secret sent as X-Jarvis-Passcode on /api/v1 routes and as a query
# parameter on WebSocket handshakes. Also read by mcp_server.py.
# Empty or unset means the API does not check a passcode.
JARVIS_PASSCODE=

# --- LLM engines ---
# Groq key for the fast engine. Empty or unset disables that engine.
GROQ_API_KEY=

# Google AI Studio key for the deep engine. Empty or unset disables that engine.
# With both keys empty, Jarvis uses the local echo engine and says so.
GEMINI_API_KEY=

# Model id for the Groq engine. Empty uses the default built into app/core/config.py.
GROQ_MODEL=

# Model id for the Gemini engine. Empty uses the default built into app/core/config.py.
GEMINI_MODEL=

# Key for the web.search tool. Empty makes that tool report itself as
# unconfigured instead of inventing results.
SEARCH_API_KEY=

# --- Storage ---
# Postgres connection URL. Empty uses the SQLite file at JARVIS_DB_PATH.
# Accepted schemes are postgresql and postgres.
DATABASE_URL=

# SQLite file path used when DATABASE_URL is empty.
JARVIS_DB_PATH=

# --- Process ---
# Display name stored on the settings object. Empty uses the built-in default.
JARVIS_APP_NAME=

# Verbose logging when set to 1, true, yes, or on. Empty is off.
JARVIS_DEBUG=

# Comma-separated browser origins for CORS. The installed PWA is same-origin
# and does not need this. Empty uses the built-in default, which allows any origin.
JARVIS_CORS_ORIGINS=

# --- Todos / Telegram ---
# Bot token for reminder delivery. Empty leaves reminders unconfigured:
# the sweep sends nothing and does not mark todos as reminded.
TELEGRAM_BOT_TOKEN=

# Chat id that receives those reminders. Unused when TELEGRAM_BOT_TOKEN is empty.
TELEGRAM_CHAT_ID=

# --- MCP server ---
# Base URL of a running Jarvis, used only by mcp_server.py. Empty uses the
# built-in local default.
JARVIS_URL=

# --- Tests ---
# Postgres URL for the test suite. Empty runs tests on a temporary SQLite file.
# Not read by the application itself.
JARVIS_TEST_DATABASE_URL=
