{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "FeedStatus": {
      "enum": [
        "ok",
        "degraded",
        "unavailable"
      ],
      "title": "FeedStatus",
      "type": "string"
    },
    "Mode": {
      "description": "Execution stance the engine is reporting. Live is intentionally absent.",
      "enum": [
        "paper",
        "shadow",
        "research"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3,10}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Performance": {
      "additionalProperties": false,
      "properties": {
        "expectancy": {
          "$ref": "#/$defs/Money"
        },
        "max_drawdown": {
          "$ref": "#/$defs/Money"
        },
        "period": {
          "$ref": "#/$defs/PerformancePeriod"
        },
        "sharpe": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sharpe"
        },
        "trades_count": {
          "minimum": 0,
          "title": "Trades Count",
          "type": "integer"
        },
        "win_rate": {
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Win Rate",
          "type": "string"
        }
      },
      "required": [
        "period",
        "trades_count",
        "win_rate",
        "expectancy",
        "max_drawdown",
        "sharpe"
      ],
      "title": "Performance",
      "type": "object"
    },
    "PerformancePeriod": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "label",
        "start",
        "end"
      ],
      "title": "PerformancePeriod",
      "type": "object"
    },
    "SourceEngine": {
      "enum": [
        "crypto-signal-engine",
        "nse-trade"
      ],
      "title": "SourceEngine",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/Performance"
    },
    "data_as_of": {
      "format": "date-time",
      "title": "Data As Of",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ApiError"
      },
      "title": "Errors",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "is_stale": {
      "title": "Is Stale",
      "type": "boolean"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_engine": {
      "$ref": "#/$defs/SourceEngine"
    },
    "status": {
      "$ref": "#/$defs/FeedStatus"
    }
  },
  "required": [
    "source_engine",
    "schema_version",
    "generated_at",
    "data_as_of",
    "status",
    "is_stale",
    "mode",
    "correlation_id",
    "data",
    "errors"
  ],
  "title": "Envelope[Performance]",
  "type": "object"
}
