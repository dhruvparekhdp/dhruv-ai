{
  "$defs": {
    "Mode": {
      "description": "Execution stance the engine is reporting. Live is intentionally absent.",
      "enum": [
        "paper",
        "shadow",
        "research"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3,10}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "Side": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "closed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Closed At"
    },
    "fees": {
      "$ref": "#/$defs/Money"
    },
    "id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "pnl": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ]
    },
    "price": {
      "$ref": "#/$defs/Money"
    },
    "qty": {
      "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Qty",
      "type": "string"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "strategy": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Strategy",
      "type": "string"
    },
    "symbol": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "id",
    "symbol",
    "side",
    "qty",
    "price",
    "fees",
    "opened_at",
    "closed_at",
    "pnl",
    "strategy",
    "mode"
  ],
  "title": "Trade",
  "type": "object"
}
