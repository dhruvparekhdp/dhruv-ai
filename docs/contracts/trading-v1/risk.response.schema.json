{
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "ConfiguredLimit": {
      "additionalProperties": false,
      "properties": {
        "max_leverage": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Leverage"
        },
        "max_notional": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ConfiguredLimit",
      "type": "object"
    },
    "Exposure": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "kind": {
          "pattern": "^(symbol|sector)$",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "amount"
      ],
      "title": "Exposure",
      "type": "object"
    },
    "FeedStatus": {
      "enum": [
        "ok",
        "degraded",
        "unavailable"
      ],
      "title": "FeedStatus",
      "type": "string"
    },
    "LimitBreach": {
      "additionalProperties": false,
      "properties": {
        "actual_leverage": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Leverage"
        },
        "actual_notional": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit_leverage": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Leverage"
        },
        "limit_notional": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "message"
      ],
      "title": "LimitBreach",
      "type": "object"
    },
    "Mode": {
      "description": "Execution stance the engine is reporting. Live is intentionally absent.",
      "enum": [
        "paper",
        "shadow",
        "research"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3,10}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "RiskSnapshot": {
      "additionalProperties": false,
      "properties": {
        "breaches": {
          "items": {
            "$ref": "#/$defs/LimitBreach"
          },
          "title": "Breaches",
          "type": "array"
        },
        "exposure": {
          "items": {
            "$ref": "#/$defs/Exposure"
          },
          "title": "Exposure",
          "type": "array"
        },
        "leverage": {
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Leverage",
          "type": "string"
        },
        "limits": {
          "items": {
            "$ref": "#/$defs/ConfiguredLimit"
          },
          "title": "Limits",
          "type": "array"
        }
      },
      "required": [
        "exposure",
        "leverage",
        "limits",
        "breaches"
      ],
      "title": "RiskSnapshot",
      "type": "object"
    },
    "SourceEngine": {
      "enum": [
        "crypto-signal-engine",
        "nse-trade"
      ],
      "title": "SourceEngine",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/RiskSnapshot"
    },
    "data_as_of": {
      "format": "date-time",
      "title": "Data As Of",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ApiError"
      },
      "title": "Errors",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "is_stale": {
      "title": "Is Stale",
      "type": "boolean"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "schema_version": {
      "pattern": "^1\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "source_engine": {
      "$ref": "#/$defs/SourceEngine"
    },
    "status": {
      "$ref": "#/$defs/FeedStatus"
    }
  },
  "required": [
    "source_engine",
    "schema_version",
    "generated_at",
    "data_as_of",
    "status",
    "is_stale",
    "mode",
    "correlation_id",
    "data",
    "errors"
  ],
  "title": "Envelope[RiskSnapshot]",
  "type": "object"
}
